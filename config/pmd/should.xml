<?xml version='1.0' encoding='UTF-8'?>
<ruleset xmlns="http://pmd.sourceforge.net/ruleset/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="smq PMD SHOULD rules" xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>All PMD Java rule categories with project-specific complexity thresholds.</description>
    <rule ref="category/java/bestpractices.xml" />
    <rule ref="category/java/codestyle.xml">
        <!-- STYLE-011 prohibits package-access marker comments. -->
        <exclude name="CommentDefaultAccessModifier" />
    </rule>
    <rule ref="category/java/design.xml">
        <exclude name="CognitiveComplexity" />
        <exclude name="CyclomaticComplexity" />
        <!-- This rule requires an explicit list of packages or types to restrict. -->
        <exclude name="LoosePackageCoupling" />
    </rule>
    <rule ref="category/java/documentation.xml">
        <exclude name="CommentRequired" />
    </rule>
    <rule ref="category/java/errorprone.xml" />
    <rule ref="category/java/multithreading.xml" />
    <rule ref="category/java/performance.xml" />
    <rule ref="category/java/security.xml" />
    <rule ref="category/java/documentation.xml/CommentRequired">
        <properties>
            <!-- Keep Javadoc requirements within the visibility allowed by STYLE-011. -->
            <property name="violationSuppressXPath" value=".[not(@EffectiveVisibility = ('public', 'protected')) or ancestor::*[@EffectiveVisibility and not(@EffectiveVisibility = ('public', 'protected'))]]" />
        </properties>
    </rule>
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="15" />
        </properties>
    </rule>
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10" />
            <property name="classReportLevel" value="80" />
            <property name="violationSuppressXPath" value=".[self::ClassDeclaration[parent::CompilationUnit and @CanonicalName = ('io.github.ppzxc.smq.storage.sqlite.SqliteStorage', 'io.github.ppzxc.smq.benchmark.random.RandomRun')]]" />
        </properties>
    </rule>
</ruleset>
