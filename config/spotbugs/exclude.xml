<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- NewMessage borrows publish data; storage copies or persists it before returning. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.NewMessage"/>
        <Field name="~(payload|headers)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- QueueOptions is not serializable and the public API does not promise exception serialization;
         retain both option values for the exception accessors. -->
    <Match>
        <Class name="io.github.ppzxc.smq.QueueDeclarationConflictException"/>
        <Field name="~(existing|requested)"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <!-- acquire transfers the lock to read/runLocked, which unlock in finally; failed acquisition owns no lock. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.sqlite.TransactionExecutor"/>
        <Method name="acquire"/>
        <Bug pattern="UL_UNRELEASED_LOCK"/>
    </Match>
</FindBugsFilter>
