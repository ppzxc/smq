<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- NewMessage borrows publish data; storage copies or persists it before returning. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.NewMessage"/>
        <Field name="~(payload|headers)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- QueueOptions is not serializable and the public API does not promise exception serialization;
         retain both option values for the exception accessors. -->
    <Match>
        <Class name="io.github.ppzxc.smq.QueueDeclarationConflictException"/>
        <Field name="~(existing|requested)"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <!-- acquire transfers the lock to read/runLocked, which unlock in finally; failed acquisition owns no lock. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.sqlite.TransactionExecutor"/>
        <Method name="acquire"/>
        <Bug pattern="UL_UNRELEASED_LOCK"/>
    </Match>
    <!-- A close race yields an empty result; otherwise the original storage runtime failure escapes. -->
    <Match>
        <Class name="io.github.ppzxc.smq.PullWaiter"/>
        <Method name="attemptUnlessClosed"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <!-- Opening preserves runtime exception identity and maps SQL failures without changing their cause. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.sqlite.SqliteStorage"/>
        <Method name="open" params="java.nio.file.Path,io.github.ppzxc.smq.Durability,java.time.Duration,io.github.ppzxc.smq.storage.sqlite.SqliteStorage$Connector,boolean" returns="io.github.ppzxc.smq.storage.sqlite.SqliteStorage"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.github.ppzxc.smq.storage.sqlite.SqliteStorage"/>
        <Method name="openFailure"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <!-- JDBC reflection must propagate the target's original checked exception, runtime exception, or error. -->
    <Match>
        <Class name="io.github.ppzxc.smq.storage.sqlite.StatementCachingConnection"/>
        <Method name="invoke"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_THROWABLE"/>
    </Match>
</FindBugsFilter>
